# ─── Groq API Configuration ──────────────────────────────────────────
# Get your free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─── Production Security & Rate Limiting (Optional Overrides) ────────
# Read endpoints rate limit per client IP (default: 60/minute)
RATE_LIMIT_READ=60/minute

# Harvest endpoint rate limit per client IP (default: 5/hour)
RATE_LIMIT_HARVEST=5/hour

# Minimum cooldown between harvests in seconds (default: 600s / 10 minutes)
HARVEST_COOLDOWN_SECONDS=600

# Global maximum harvests allowed across the entire app per hour (default: 4)
MAX_HARVESTS_PER_HOUR=4

# Optional: Require X-API-Key header to trigger /api/harvest (leave empty for public)
# HARVEST_API_KEY=your_secret_harvest_key_here

# In-memory digest cache TTL in seconds (default: 300s / 5 minutes)
CACHE_TTL_SECONDS=300

# ─── Email brief (daily delivery) ────────────────────────────────────
# Any SMTP provider works. Gmail: smtp.gmail.com, port 587, an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
# PUBLIC_URL=https://techpulse-ai-digest.onrender.com/
# BRIEF_TOP_N=7
# MIN_KEPT_ITEMS=5

# ─── Ratings (thumbs up / down) ──────────────────────────────────────
# Signs the one-click links in the email; any long random string.
# FEEDBACK_SECRET=
# Fine-grained GitHub token, this repo only, Contents: read and write. Lets the web app
# store ratings on the `feedback` branch so they survive restarts. Optional.
# FEEDBACK_GITHUB_TOKEN=
# Requires this key to rate items or run a harvest from the site.
# HARVEST_API_KEY=
